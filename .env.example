# Fighting-game server port (reference arena uses 3000; this game uses 8000)
PORT=8000

# =========================================================
# MICROSOFT SQL SERVER CONFIGURATION (shared database)
# Same keys and same database as Cybersecurity2026---Game so
# both games persist to CyberSecurity2025.
# If DB_SERVER is unset/unreachable, the server automatically
# falls back to local JSON persistence (data/fighting_results.json).
# DO NOT commit a real .env — copy this file to .env and fill
# in the real password locally.
# =========================================================

# Database Host (e.g. localhost, 192.168.1.50, or host\SQLEXPRESS)
DB_SERVER=
DB_PORT=
DB_DRIVER=SQL Server

# Database Authentication
DB_USER=
DB_PASSWORD=replace-with-password

# Database Name (shared with the arena game)
DB_NAME=CyberSecurity2025

# Encryption & Certificate Settings (Set to true for self-signed certificates)
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
